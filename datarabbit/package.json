{
  "name": "calliope-datarabbit",
  "version": "1.2.3",
  "private": true,
  "description": "The DataRabbit SQL and operational console shipped with Calliope.",
  "scripts": {
    "build:calliope-data": "node scripts/build-calliope-data.mjs",
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/sync-standalone-assets.mjs",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint",
    "check:sql-viz": "node scripts/check-sql-viz-primitives.cjs",
    "demo:locks": "node scripts/lock-explorer-demo.mjs start",
    "demo:locks:status": "node scripts/lock-explorer-demo.mjs status",
    "demo:locks:stop": "node scripts/lock-explorer-demo.mjs stop",
    "typecheck": "tsc --noEmit",
    "dev:mac": "concurrently --kill-others-on-fail --success first --names server,mac --prefix-colors blue,magenta \"npm:dev:server\" \"npm:dev:electron\"",
    "dev:server": "next dev --hostname 127.0.0.1 --port 3100",
    "dev:electron": "wait-on http://127.0.0.1:3100 && electron .",
    "dev:web": "next dev",
    "prebuild": "node scripts/clean-mac-build.mjs",
    "build:icon": "node scripts/build-mac-icon.mjs",
    "pack:mac": "npm run build:icon && npm run build && electron-builder --projectDir electron --mac --dir",
    "dist:mac": "npm run build:icon && npm run build && electron-builder --projectDir electron --mac",
    "dist:mac:release": "node scripts/check-mac-release-credentials.mjs && npm run build:icon && npm run build && electron-builder --projectDir electron --mac -c.forceCodeSigning=true -c.mac.notarize=true && npm run verify:mac:release",
    "verify:mac": "node scripts/verify-mac-release.mjs",
    "verify:mac:release": "DATARABBIT_REQUIRE_NOTARIZED=1 node scripts/verify-mac-release.mjs",
    "test:mac:smoke": "node scripts/smoke-electron.mjs",
    "test:mac:rvbbit": "node scripts/smoke-rvbbit-reference.mjs",
    "test:mac:surfaces": "node scripts/smoke-launcher-parity.mjs",
    "test:mac:persistence": "node scripts/smoke-persistence.mjs",
    "test:mac:write-workflows": "node scripts/smoke-write-workflows.mjs",
    "lint:mac": "eslint electron/after-pack.cjs electron/main.cjs electron/preload.cjs scripts/build-mac-icon.mjs scripts/check-mac-release-credentials.mjs scripts/clean-mac-build.mjs scripts/sync-standalone-assets.mjs scripts/smoke-electron.mjs scripts/smoke-launcher-parity.mjs scripts/smoke-persistence.mjs scripts/smoke-rvbbit-reference.mjs scripts/smoke-write-workflows.mjs scripts/verify-mac-release.mjs src/types/datarabbit-desktop.d.ts src/components/desktop/command-palette.tsx src/components/desktop/desktop-icon.tsx src/components/desktop/desktop-menu-bar.tsx src/components/desktop/desktop-window.tsx src/components/desktop/folder-window.tsx src/components/desktop/scry-canvas.tsx",
    "dist:linux": "npm run build:icon && npm run build && electron-builder --projectDir electron --linux"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@gradio/client": "^2.3.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-virtual": "^3.13.23",
    "@types/js-yaml": "^4.0.9",
    "@types/pg": "^8.18.0",
    "@types/pg-copy-streams": "^1.2.5",
    "@uiw/react-codemirror": "^4.25.8",
    "ag-grid-community": "^35.2.0",
    "ag-grid-react": "^35.2.0",
    "chart.js": "^4.5.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cron-parser": "^5.5.0",
    "cronstrue": "^3.14.0",
    "csv-parse": "^6.2.1",
    "echarts": "^6.1.0",
    "flint-chart": "^0.1.3",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout-forceatlas2": "^0.10.1",
    "js-yaml": "^4.1.1",
    "modern-screenshot": "^4.7.0",
    "next": "16.2.6",
    "node-vibrant": "^4.0.4",
    "pg": "^8.20.0",
    "pg-copy-streams": "^7.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-vega": "^8.0.0",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "shiki": "^4.0.2",
    "sigma": "^3.0.3",
    "sql-formatter": "^15.7.3",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.5.0",
    "thinking-orbs": "^0.1.1",
    "tw-animate-css": "^1.4.0",
    "vega": "^6.2.0",
    "vega-lite": "^6.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@types/ssh2": "^1.15.5",
    "concurrently": "^10.0.3",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "playwright-core": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.3.1",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "$sharp"
  }
}
