+def _unwrap_redundant_arguments_object(
+    name: str, raw_args: Dict[str, Any]
+) -> Dict[str, Any]:
+    """Repair one provably redundant ``arguments`` wrapper.
+
+    The repair is schema-bound and fail-closed: it only unwraps an object
+    whose sole key is ``arguments`` when the registered target schema does
+    not define that parameter and the nested object contains a known field.
+    """
+    nested = raw_args.get("arguments")
+    if set(raw_args) != {"arguments"} or not isinstance(nested, dict):
+        return raw_args
+    try:
+        from tools.registry import registry as _registry
+        schema = _registry.get_schema(name)
+        if not isinstance(schema, dict):
+            return raw_args
+        fn = schema.get("function") if schema.get("type") == "function" else schema
+        if not isinstance(fn, dict):
+            return raw_args
+        params = fn.get("parameters")
+        properties = params.get("properties") if isinstance(params, dict) else None
+        if not isinstance(properties, dict) or "arguments" in properties:
+            return raw_args
+        if not any(key in properties for key in nested):
+            return raw_args
+        logger.info("Unwrapped redundant arguments object for deferred tool %s", name)
+        return nested
+    except Exception:  # pragma: no cover — schema failure must not alter calls
+        logger.debug(
+            "redundant arguments wrapper check failed for %s", name, exc_info=True
+        )
+        return raw_args
+
+
 def resolve_underlying_call(args: Dict[str, Any]) -> Tuple[Optional[str], Dict[str, Any], Optional[str]]:
     """Parse a ``tool_call`` invocation into (underlying_name, args, error_msg).
 
