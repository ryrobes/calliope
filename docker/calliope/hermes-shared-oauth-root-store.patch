+def _credential_pool_write_target(provider_id: str) -> Optional[Path]:
+    """Return the store that owns a credential-pool provider slice.
+
+    ``None`` means the active profile store. The global root is returned only
+    when the profile has no local entries and is reading non-empty fallback
+    entries from the root.
+    """
+    global_root = _global_auth_file_path()
+    if global_root is None:
+        return None
+    try:
+        local_pool = _load_auth_store().get("credential_pool")
+        local_entries = local_pool.get(provider_id) if isinstance(local_pool, dict) else None
+        if isinstance(local_entries, list) and local_entries:
+            return None
+        global_pool = _load_global_auth_store().get("credential_pool")
+        global_entries = global_pool.get(provider_id) if isinstance(global_pool, dict) else None
+        if isinstance(global_entries, list) and global_entries:
+            return global_root
+    except Exception:
+        return None
+    return None
 
 
