 _LENGTH_CONTINUATION_DROPPED_TOOLS_PREFIX = "[System: Your previous tool call "
 
 
+# ── Silent route output-ceiling discovery ───────────────────────────────
+# A provider route can clamp completions FAR below the requested max_tokens
+# and still return HTTP 200 with finish_reason="length" (observed 2026-08-20:
+# google/gemma-4-31b-it via OpenRouter cut every response near ~1.7k tokens
+# against a 32,768-token request). No error text accompanies the clamp, so
+# parse_available_output_tokens_from_error never fires, and the boosted
+# retry ladder re-runs the identical request into the same server-side wall
+# four times before giving up. When a truncated response's own usage shows
+# completions far below what was requested, the truncation point IS the
+# route's real ceiling: remember it for the session, stop boosting past it,
+# and tell the model its actual budget so it can re-plan the work into
+# smaller pieces. Models that fill their requested budget (observed ≈
+# requested) never trip the ratio, so honest large-output routes keep the
+# original ladder untouched.
+# The loop-level seams live in agent/turn_truncation.py (finish_reason="length")
+# and agent/turn_tool_validation.py (router-masked truncation) since 0.21.4;
+# both import these helpers lazily (module-level import would be a cycle).
+_SILENT_OUTPUT_CLAMP_RATIO = 0.6
+# One short truncation is an anecdote, not a ceiling: models also stop short
+# mid-JSON for reasons that have nothing to do with a route clamp (observed
+# 2026-08-20: a single 371-token cut got promoted to a "measured ceiling",
+# and the one-shot request override then enforced it on the retry — a
+# self-fulfilling prophecy). Numeric claims and the request-cap override
+# wait for a second observation; tiny cuts do not count as observations at
+# all, and the override is never set below a workable floor.
+_SILENT_CAP_MIN_OBSERVATION = 256
+_SILENT_CAP_MIN_EPHEMERAL = 1024
+
+
+def _note_silent_output_clamp(agent: Any, observed: int) -> tuple:
+    """Record one silent-clamp observation on the agent (session-scoped).
+    Returns (ceiling, budget, corroborated); only a corroborated ceiling of
+    workable size installs the one-shot request override."""
+    prior = list(getattr(agent, "_silent_output_cap_observations", []) or [])
+    prior.append(observed)
+    agent._silent_output_cap_observations = prior[-8:]
+    ceiling = max(prior)
+    budget = max(256, int(ceiling * 0.85))
+    corroborated = len(prior) >= 2
+    if corroborated and ceiling >= _SILENT_CAP_MIN_EPHEMERAL:
+        agent._ephemeral_max_output_tokens = ceiling
+    return ceiling, budget, corroborated
+
+
+def _last_message_is_replan_nudge(messages: Any) -> bool:
+    tail = messages[-1] if messages else None
+    return (
+        isinstance(tail, dict)
+        and tail.get("role") == "user"
+        and str(tail.get("content") or "").startswith(_LENGTH_CONTINUATION_DROPPED_TOOLS_PREFIX)
+    )
+
+
+def _observed_completion_tokens(response: Any) -> Optional[int]:
+    """Completion tokens actually delivered on a (possibly truncated)
+    response, across api modes; None when the provider sent no usage."""
+    usage = getattr(response, "usage", None)
+    if usage is None and isinstance(response, dict):
+        usage = response.get("usage")
+    if usage is None:
+        return None
+    for key in ("completion_tokens", "output_tokens"):
+        raw = getattr(usage, key, None)
+        if raw is None and isinstance(usage, dict):
+            raw = usage.get(key)
+        try:
+            value = int(raw)
+        except (TypeError, ValueError):
+            continue
+        if value > 0:
+            return value
+    return None
+
+
+def _silent_cap_replan_nudge(ceiling: Optional[int] = None, budget: Optional[int] = None) -> str:
+    """Re-plan instruction after a tool call was cut off mid-arguments.
+    With a measured ceiling the budget is stated; without one (router masked
+    finish_reason and no usable usage arithmetic) the guidance stays
+    qualitative. Starts with _LENGTH_CONTINUATION_DROPPED_TOOLS_PREFIX so
+    agent.context_compressor recognizes a persisted copy as ephemeral
+    scaffolding, exactly like the chunked-retry nudge."""
+    if ceiling and budget:
+        cause = (
+            f"this provider route stops every response at ~{ceiling:,} "
+            f"tokens, regardless of the larger configured budget"
+        )
+        limit = f"under ~{budget:,} tokens"
+    else:
+        cause = "this provider route is cutting long responses short"
+        limit = "well under your previous response's length"
+    return (
+        f"{_LENGTH_CONTINUATION_DROPPED_TOOLS_PREFIX}was cut off "
+        f"mid-arguments and was NOT executed: {cause}. Do not retry the "
+        f"same large call. Re-plan so every response stays {limit}: emit "
+        f"large content in several small steps (for a big document, write "
+        f"it to a file in section-sized appends across multiple tool calls, "
+        f"then use the file path), and keep prose answers short.]"
+    )
+
+
 def _get_continuation_prompt(is_partial_stub: bool, dropped_tools: Optional[List[str]] = None) -> str:
