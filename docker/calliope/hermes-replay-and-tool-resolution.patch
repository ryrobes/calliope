+def _route_exact_deferred_tool_call(agent: Any, tc: Any) -> bool:
+    """Use the native bridge for an exact, session-scoped deferred capability.
+
+    This changes only the dispatch envelope. Tool identity, arguments and call ID
+    survive; the executor still performs its normal scope/schema/approval checks.
+    """
+    if "tool_call" not in agent.valid_tool_names:
+        return False
+    from agent.tool_executor import _tool_search_scoped_names
+
+    name = tc.function.name
+    if name not in _tool_search_scoped_names(agent):
+        return False
+    arguments = tc.function.arguments
+    try:
+        if isinstance(arguments, str):
+            arguments = json.loads(arguments) if arguments.strip() else {}
+        elif arguments is None:
+            arguments = {}
+        if not isinstance(arguments, dict):
+            return False
+        envelope = json.dumps({"calls": [{"name": name, "arguments": arguments}]})
+    except (TypeError, ValueError):
+        return False
+    tc.function.name = "tool_call"
+    tc.function.arguments = envelope
+    logger.info("Routed exact deferred tool %s through tool_call", name)
+    return True
+
+
