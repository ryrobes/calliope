#!/usr/bin/env python3
"""Quiet, deterministic validation for Calliope-authored web artifacts."""

from __future__ import annotations

import argparse
import os
import subprocess
import sys
import tempfile
from html.parser import HTMLParser
from pathlib import Path


CONFIG_ROOT = Path(
    os.environ.get("CALLIOPE_WEB_CHECK_CONFIG_ROOT", "/opt/hermes/calliope/web-check")
)


class EmbeddedSourceParser(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=False)
        self.active: str | None = None
        self.scripts: list[str] = []
        self.styles: list[str] = []

    def handle_starttag(self, tag, attrs):
        attrs_map = {str(key).lower(): value for key, value in attrs}
        if tag.lower() == "script" and not attrs_map.get("src"):
            script_type = str(attrs_map.get("type") or "").lower()
            if script_type in {"", "text/javascript", "application/javascript", "module"}:
                self.active = "script"
        elif tag.lower() == "style":
            self.active = "style"

    def handle_endtag(self, tag):
        if tag.lower() in {"script", "style"}:
            self.active = None

    def handle_data(self, data):
        if self.active == "script":
            self.scripts.append(data)
        elif self.active == "style":
            self.styles.append(data)


def run(command: list[str]) -> bool:
    result = subprocess.run(command, text=True, capture_output=True, check=False)
    if result.returncode == 0:
        return True
    details = (result.stdout + result.stderr).strip()
    print(f"FAIL: {' '.join(command[:2])}", file=sys.stderr)
    if details:
        print(details, file=sys.stderr)
    return False


def prettier_parse(path: Path, parser: str | None = None) -> bool:
    command = ["prettier"]
    if parser:
        command.extend(["--parser", parser])
    command.append(str(path))
    result = subprocess.run(
        command,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if result.returncode == 0:
        return True
    print(f"FAIL: Prettier could not parse {path}", file=sys.stderr)
    if result.stderr.strip():
        print(result.stderr.strip(), file=sys.stderr)
    return False


def lint_javascript(path: Path) -> bool:
    return run([
        "eslint",
        "--config",
        str(CONFIG_ROOT / "eslint.config.mjs"),
        str(path),
    ])


def validate_html(path: Path) -> bool:
    ok = prettier_parse(path, "html")
    ok = run([
        "html-validate",
        "--config",
        str(CONFIG_ROOT / "htmlvalidate.json"),
        str(path),
    ]) and ok
    try:
        parser = EmbeddedSourceParser()
        parser.feed(path.read_text(encoding="utf-8"))
        parser.close()
    except (OSError, UnicodeDecodeError) as exc:
        print(f"FAIL: could not read {path}: {exc}", file=sys.stderr)
        return False
    with tempfile.TemporaryDirectory(prefix="calliope-web-check-") as temp:
        root = Path(temp)
        if parser.scripts:
            script = root / "embedded.js"
            script.write_text("\n;\n".join(parser.scripts), encoding="utf-8")
            ok = prettier_parse(script, "babel") and ok
            ok = lint_javascript(script) and ok
        if parser.styles:
            style = root / "embedded.css"
            style.write_text("\n".join(parser.styles), encoding="utf-8")
            ok = prettier_parse(style, "css") and ok
    return ok


def validate(path: Path) -> bool:
    suffix = path.suffix.lower()
    if suffix in {".html", ".htm"}:
        return validate_html(path)
    if suffix in {".js", ".mjs", ".cjs"}:
        return prettier_parse(path, "babel") and lint_javascript(path)
    if suffix == ".css":
        return prettier_parse(path, "css")
    if suffix == ".json":
        return prettier_parse(path, "json")
    print(f"FAIL: unsupported web source type: {path}", file=sys.stderr)
    return False


def main() -> int:
    cli = argparse.ArgumentParser(
        description="Parse and lint Calliope HTML, JavaScript, CSS, and JSON without rewriting it."
    )
    cli.add_argument("paths", nargs="+", type=Path)
    args = cli.parse_args()
    ok = True
    for path in args.paths:
        if not path.is_file():
            print(f"FAIL: file not found: {path}", file=sys.stderr)
            ok = False
            continue
        current = validate(path)
        if current:
            print(f"OK: {path}")
        ok = current and ok
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())
