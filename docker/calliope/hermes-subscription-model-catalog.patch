+# Backport upstream client-version negotiation: 0.0.0 now returns a legacy catalog.
+# Ask for the newest catalog first, retaining the legacy endpoint as a fallback.
+CODEX_MODELS_CATALOG_ENDPOINT = "https://chatgpt.com/backend-api/codex/models"
