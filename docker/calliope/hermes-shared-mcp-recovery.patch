+def _restore_shared_scopes(key) -> None:
+    """A parked shared connection lost tools in EVERY adopting profile.
+
+    Reconnecting registers the owner above; restore each adopter under its own
+    current config and credentials too. This only adopts an already-live matching
+    connection: no network calls, retries, or cross-profile credential fallback.
+    """
+    from pathlib import Path
+    from agent.secret_scope import build_profile_secret_scope, reset_secret_scope, set_secret_scope
+    from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+    from tools.mcp_tool_config import _load_mcp_config
+
+    with _core._lock:
+        scopes = set(_core._server_tool_scopes.get(key, ()))
+        scopes.discard(_core._server_registry_scope(key))
+    for scope in sorted(s for s in scopes if s is not None):
+        home_token = set_hermes_home_override(scope)
+        secret_token = None
+        try:
+            secret_token = set_secret_scope(build_profile_secret_scope(Path(scope)))
+            restored = register_connected_into_current_scope(_load_mcp_config() or {})
+            if restored:
+                logger.warning("MCP: restored shared tool catalog for profile %s after connection recovery", scope)
+        except Exception:
+            logger.warning("MCP: shared tool catalog recovery failed for profile %s", scope, exc_info=True)
+        finally:
+            if secret_token is not None:
+                reset_secret_scope(secret_token)
+            reset_hermes_home_override(home_token)
 
 
