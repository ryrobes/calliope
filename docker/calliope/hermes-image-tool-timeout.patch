 _DEFAULT_TOOL_TIMEOUT = 300      # seconds for tool calls
 
 
+def _resolve_named_tool_timeout(config: dict, tool_name: str, default: float) -> float:
+    """Operator-owned per-tool budgets; ordinary tools retain their server budget."""
+    overrides = config.get("tool_timeouts")
+    value = overrides.get(tool_name) if isinstance(overrides, dict) else None
+    if isinstance(value, (int, float)) and not isinstance(value, bool) and 0 < value <= 3600:
+        return float(value)
+    return default
+
+
+def _resolve_transport_read_timeout(config: dict) -> float:
+    """A silent long-running tool must also fit inside the HTTP read budget."""
+    overrides = config.get("tool_timeouts")
+    names = overrides if isinstance(overrides, dict) else {}
+    return max([300.0] + [_resolve_named_tool_timeout(config, name, 300.0) for name in names])
+
+
