+        def _tool_complete(tool_call_id, function_name, function_args, function_result) -> None:
+            """Forward exact completion identity, with results only for supported Stage tools.
+
+            The canonical turn transcript remains the authority.  Calliope uses this
+            event as an early projection hint, then reconciles idempotently from the
+            transcript at run.completed.  Generic tool results are deliberately not
+            exposed because they may contain credentials, files, or large payloads.
+            """
+            name = str(function_name or "")
+            result_name = name
+            result_args = function_args or {}
+            if (
+                name == "tool_call"
+                and isinstance(function_args, dict)
+                and isinstance(function_args.get("arguments"), dict)
+            ):
+                result_name = str(function_args.get("name") or name)
+                result_args = function_args["arguments"]
+            payload = {
+                "message_id": message_id,
+                "tool_name": result_name,
+                "call_id": str(tool_call_id or ""),
+            }
+            from stage_delivery import receipt_fields
+            payload.update(receipt_fields(result_name, result_args, function_result))
+            events.enqueue("tool.completed", payload)
+
