+# ── Tool-loop baffles (Calliope, 2026-09-10) ─────────────────────────────
+# Two redirections, neither a stop. Measured on the pilot's session mirror:
+# reasoning tokens were 0.1–4% of spend; the burn was call count × replayed
+# context. Gemini ran 126 SQL calls in one session with 142 of 152 assistant
+# turns silent (one runaway of 913 silent turns); grok re-issued the same
+# search_data call 14 times. Well-behaved models rarely make a THIRD identical
+# read (astra 6%, grok-4.6 7%), so serving that from the session costs them
+# nothing, and a status paragraph every 30 silent tool turns touches sol two
+# or three times a day.
+# The loop-level seams live in agent/turn_tool_round.py since 0.21.4 (lazy import).
+_ECHO_BAFFLE_THIRD_CALL = 3
+_ECHO_BAFFLE_READ_ONLY_RE = re.compile(
+    r"run_sql|validate_sql|search_data|capability_search|describe_table|tool_describe|"
+    r"tool_search|hindsight_recall|list_metrics|get_metric|metric_history|"
+    r"search_business_context|session_search|get_live_app|list_live_apps|"
+    r"list_calliope_specialists|skill_view|read_file|search_files|"
+    r"(?:^|__)metric$|metric_catalog",
+    re.IGNORECASE,
+)
+_ECHO_BAFFLE_NOTE = (
+    "[Echo baffle] This is identical call #{count} to {name} in this session. "
+    "The result below is the one you already received, unchanged — it was not "
+    "re-run. Use it; if you need something different, change the arguments or "
+    "say what you are looking for."
+)
+_NARRATION_NUDGE_EVERY = 30
+_NARRATION_NUDGE_PREFIX = _LENGTH_CONTINUATION_DROPPED_TOOLS_PREFIX
+
+
+def _echo_canonical_args(raw: Any) -> str:
+    """Stable text for a tool's arguments: parsed JSON re-dumped with sorted keys."""
+    if isinstance(raw, (dict, list)):
+        return json.dumps(raw, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
+    text = "" if raw is None else str(raw).strip()
+    if not text:
+        return "{}"
+    try:
+        return json.dumps(json.loads(text), sort_keys=True, separators=(",", ":"), ensure_ascii=False)
+    except (TypeError, ValueError):
+        return text
+
+
+def _echo_key(tool_call: Any) -> tuple[str, str] | None:
+    """(name, canonical args) — the deferred ``tool_call`` wrapper is unwrapped so a
+    wrapped and a direct call to the same tool share one key."""
+    function = getattr(tool_call, "function", None)
+    name = str(getattr(function, "name", "") or "").strip()
+    if not name:
+        return None
+    args = _echo_canonical_args(getattr(function, "arguments", None))
+    if name == "tool_call":
+        try:
+            parsed = json.loads(args)
+        except (TypeError, ValueError):
+            parsed = None
+        if isinstance(parsed, dict):
+            inner = str(parsed.get("name") or parsed.get("tool") or "").strip()
+            if inner:
+                inner_args = parsed.get("arguments", parsed.get("args", {}))
+                return inner, _echo_canonical_args(inner_args)
+    return name, args
+
+
+def _echo_is_read_only(tool_call: Any) -> bool:
+    key = _echo_key(tool_call)
+    if key is None:
+        return False
+    return bool(_ECHO_BAFFLE_READ_ONLY_RE.search(key[0]))
+
+
+def _echo_baffle_state(agent: Any) -> dict:
+    state = getattr(agent, "_echo_baffle", None)
+    if not isinstance(state, dict):
+        state = {"counts": {}, "results": {}}
+        try:
+            agent._echo_baffle = state
+        except Exception:
+            pass
+    return state
+
+
+def _echo_baffle_split(agent: Any, tool_calls: list) -> tuple[list, list]:
+    """Partition a turn's calls into (served, execute).
+
+    A read-only call seen ``_ECHO_BAFFLE_THIRD_CALL`` or more times whose
+    earlier result is known is served from it. Any non-read call clears the
+    session's echo state first: after a write the world may have changed, so
+    the next identical read runs for real."""
+    state = _echo_baffle_state(agent)
+    served: list = []
+    execute: list = []
+    for tool_call in tool_calls or []:
+        if not _echo_is_read_only(tool_call):
+            state["counts"].clear()
+            state["results"].clear()
+            execute.append(tool_call)
+            continue
+        key = _echo_key(tool_call)
+        count = state["counts"].get(key, 0) + 1
+        state["counts"][key] = count
+        cached = state["results"].get(key)
+        if count >= _ECHO_BAFFLE_THIRD_CALL and isinstance(cached, str) and cached:
+            note = _ECHO_BAFFLE_NOTE.format(count=count, name=key[0])
+            served.append((tool_call, f"{note}\n\n{cached}"))
+        else:
+            execute.append(tool_call)
+    return served, execute
+
+
+def _echo_baffle_record(agent: Any, tool_calls: list, messages: list) -> int:
+    """Remember the results the executed read-only calls just produced."""
+    state = _echo_baffle_state(agent)
+    wanted: dict[str, tuple[str, str]] = {}
+    for tool_call in tool_calls or []:
+        if not _echo_is_read_only(tool_call):
+            continue
+        key = _echo_key(tool_call)
+        call_id = str(coalesce_tool_call_id(tool_call) or "")
+        if key is not None and call_id:
+            wanted[call_id] = key
+    if not wanted:
+        return 0
+    stored = 0
+    for message in reversed(messages[-(2 * len(wanted) + 8):]):
+        if not isinstance(message, dict) or message.get("role") != "tool":
+            continue
+        key = wanted.get(str(message.get("tool_call_id") or ""))
+        if key is None:
+            continue
+        content = message.get("content")
+        if isinstance(content, list):
+            content = "\n".join(
+                str(part.get("text", "")) if isinstance(part, dict) else str(part)
+                for part in content
+            )
+        if isinstance(content, str) and content and not content.startswith("[Echo baffle]"):
+            state["results"][key] = content
+            stored += 1
+    return stored
+
+
+def _narration_streak_update(agent: Any, silent: bool, api_call_count: int = 0) -> int:
+    """Consecutive assistant turns that carried tool calls and no visible text."""
+    streak = int(getattr(agent, "_narration_silent_turns", 0) or 0)
+    if api_call_count <= 1:
+        streak = 0
+    streak = streak + 1 if silent else 0
+    try:
+        agent._narration_silent_turns = streak
+    except Exception:
+        pass
+    return streak
+
+
+def _narration_nudge_due(streak: int) -> bool:
+    return streak >= _NARRATION_NUDGE_EVERY and streak % _NARRATION_NUDGE_EVERY == 0
+
+
+def _narration_nudge_text(streak: int) -> str:
+    # Starts with the compressor-recognized prefix so the context compressor
+    # treats it as ephemeral scaffolding (see _LENGTH_CONTINUATION_DROPPED_TOOLS_PREFIX).
+    return (
+        f"{_NARRATION_NUDGE_PREFIX}streak has reached {streak} consecutive turns "
+        "with no words to the user. Before the next tool call, write one short "
+        "paragraph: what you have established so far, what remains, and whether "
+        "the original ask could be answered now or handed to a specialist. Then "
+        "continue.]"
+    )
+
