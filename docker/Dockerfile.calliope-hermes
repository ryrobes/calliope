    && git apply --check /tmp/hermes-capability-discovery.patch \
    && git apply /tmp/hermes-capability-discovery.patch \
    && python /tmp/test-hermes-capability-discovery.py \
    && rm /tmp/hermes-capability-discovery.patch /tmp/test-hermes-capability-discovery.py

