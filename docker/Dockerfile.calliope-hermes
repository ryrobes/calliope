    && python /tmp/apply-hermes-cron-timezones.py \
    && python /tmp/test-hermes-cron-timezones.py \
    && rm /tmp/apply-hermes-cron-timezones.py /tmp/test-hermes-cron-timezones.py \
    && python /tmp/test-hermes-v021-upstream-contracts.py \
    && rm /tmp/hermes-forward-session-identity.patch /tmp/hermes-skill-index.patch /tmp/hermes-progressive-sql-results.patch /tmp/hermes-runs-progressive-sql-results.patch /tmp/hermes-deepinfra-output-cap.patch /tmp/hermes-explicit-small-context.patch /tmp/hermes-profile-log-routing.patch /tmp/hermes-command-catalog.patch /tmp/hermes-auxiliary-tts-rewrite.patch /tmp/hermes-tool-result-wire-name.patch /tmp/hermes-deferred-tool-argument-unwrap.patch /tmp/hermes-shared-oauth-root-store.patch /tmp/hermes-silent-output-cap.patch /tmp/test-hermes-silent-output-cap.py /tmp/hermes-tool-baffles.patch /tmp/test-hermes-tool-baffles.py /tmp/hermes-pinned-tools.patch /tmp/test-hermes-pinned-tools.py /tmp/test-hermes-shared-oauth-root-store.py /tmp/test-hermes-profile-log-routing.py /tmp/test-hermes-tool-result-wire-name.py /tmp/test-hermes-deferred-tool-argument-unwrap.py /tmp/apply-hermes-cron-execution-ledger.py /tmp/test-hermes-cron-execution-ledger.py /tmp/test-hermes-v021-upstream-contracts.py

RUN --mount=type=bind,source=docker/calliope,target=/run/calliope-build,readonly \
    cp /run/calliope-build/hermes-typed-arguments.patch /run/calliope-build/test-hermes-typed-arguments.py /tmp/ \
    && cd /opt/hermes \
    && git apply --check /tmp/hermes-typed-arguments.patch \
    && git apply /tmp/hermes-typed-arguments.patch \
    && python /tmp/test-hermes-typed-arguments.py \
    && rm /tmp/hermes-typed-arguments.patch /tmp/test-hermes-typed-arguments.py

# Upstream's stage-two hook copies cli-config.yaml.example into a new data
# volume. Existing volumes are intentionally preserved. The additional hook
# seeds only Hindsight's provider config, also on first boot.
COPY docker/calliope/hermes-config.yaml /opt/hermes/cli-config.yaml.example
COPY docker/calliope/hindsight-config.json \
    docker/calliope/SOUL.md \
    /opt/hermes/calliope/
COPY docker/calliope/hermes-profile.yaml /opt/hermes/calliope/profile.yaml
COPY docker/calliope/reconcile-hermes-config.py \
    docker/calliope/reconcile-hermes-specialists.py \
    docker/calliope/test-hermes-specialist-context.py \
    /opt/hermes/calliope/
RUN cd /opt/hermes && python -B calliope/test-hermes-specialist-context.py
RUN --mount=type=bind,source=docker/calliope,target=/run/calliope-build,readonly \
    cp /run/calliope-build/test-hermes-coordinator-delegation.py /tmp/test-hermes-coordinator-delegation.py \
    && python /tmp/test-hermes-coordinator-delegation.py && rm /tmp/test-hermes-coordinator-delegation.py
COPY docker/calliope/hermes-data-completion.py /opt/hermes/gateway/calliope_data_completion.py
RUN --mount=type=bind,source=docker/calliope,target=/run/calliope-build,readonly \
    cp /run/calliope-build/apply-hermes-data-completion.py /run/calliope-build/test-hermes-data-completion.py /tmp/ \
    && python /tmp/apply-hermes-data-completion.py \
    && python /tmp/test-hermes-data-completion.py \
    && rm /tmp/apply-hermes-data-completion.py /tmp/test-hermes-data-completion.py
# "Fork from here": copy a session up to a moment and keep the original open.
COPY docker/calliope/hermes-session-fork.py /opt/hermes/gateway/calliope_session_fork.py
RUN --mount=type=bind,source=docker/calliope,target=/run/calliope-build,readonly \
    cp /run/calliope-build/apply-hermes-session-fork.py /run/calliope-build/test-hermes-session-fork.py /tmp/ \
    && python /tmp/apply-hermes-session-fork.py \
    && cd /opt/hermes && python /tmp/test-hermes-session-fork.py \
    && rm /tmp/apply-hermes-session-fork.py /tmp/test-hermes-session-fork.py
COPY docker/calliope/speech_bridge.py /usr/local/bin/speech_bridge.py
COPY docker/calliope/reviewed_mail_bridge.py /usr/local/bin/reviewed_mail_bridge.py
COPY docker/calliope/sms_bridge.py /usr/local/bin/sms_bridge.py
COPY docker/calliope/test-sms-bridge-native.py /tmp/test-sms-bridge-native.py
RUN python /tmp/test-sms-bridge-native.py && rm /tmp/test-sms-bridge-native.py
COPY --chmod=0755 docker/calliope/hermes-gateway-supervisor.py /usr/local/bin/calliope-hermes-supervisor
COPY docker/calliope/browser-origin.py /usr/local/bin/calliope_browser_origin.py
RUN --mount=type=bind,source=docker/calliope,target=/run/calliope-build,readonly \
    cp /run/calliope-build/apply-hermes-browser-navigation.py /tmp/apply-hermes-browser-navigation.py \
    && python /tmp/apply-hermes-browser-navigation.py && rm /tmp/apply-hermes-browser-navigation.py
COPY docker/calliope/hermes-specialists/ /opt/hermes/calliope/specialists/
COPY docker/calliope/hermes-skills/ /opt/hermes/calliope/skills/
COPY docker/calliope/hermes-specialist-skills/ /opt/hermes/calliope/specialist-skills/
COPY --chmod=0755 docker/calliope/013-calliope-config /etc/cont-init.d/013-calliope-config

# Google Chat remains opt-in; installing its pull transport does not enable
# a platform or contact Google. Match the pinned upstream adapter's dependency
# set, constraining shared protobuf/auth packages to the base image versions.
RUN --mount=type=bind,source=docker/calliope,target=/run/calliope-build,readonly \
    cp /run/calliope-build/google-chat-requirements.txt /tmp/google-chat-requirements.txt \
    && uv pip install --python /opt/hermes/.venv/bin/python --no-cache \
        -r /tmp/google-chat-requirements.txt \
    && rm /tmp/google-chat-requirements.txt
COPY docker/calliope/test-hermes-google-chat.py /opt/hermes/calliope/test-hermes-google-chat.py
RUN cd /opt/hermes && python -B calliope/test-hermes-google-chat.py

# Claude Pro/Max subscription as a model provider (NousResearch's DirectSDK plugin,
# vendored at docker/calliope/hermes-plugins/source.json's revision). Baked as a
# BUNDLED model provider so it loads with no plugins.enabled entry and no data-volume
# state; it drives the official Claude Code CLI per request, so the CLI is installed
# at the version pinned in source.json and checked by the build gate. Credentials live in CLAUDE_CONFIG_DIR on
# the data volume (one login serves the coordinator and every specialist profile);
# the supervisor's paste-code login writes them, the plugin never touches them.
COPY docker/calliope/hermes-plugins/claude-subscription-directsdk-experimental/ \
     /opt/hermes/plugins/model-providers/claude-subscription-directsdk-experimental/
RUN npm install -g --no-fund --no-audit @anthropic-ai/claude-code@2.1.299 \
    && npm cache clean --force \
    && claude --version
ENV CLAUDE_CONFIG_DIR=/opt/data/.claude
# The appliance image owns the CLI version; updates ship with a new image.
ENV DISABLE_AUTOUPDATER=1
# Claude Code's telemetry, error reporting and feature-flag fetches stay off. The
# plugin defaults them on since 0.3.1 but never removes a flag Hermes already has.
ENV CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    DISABLE_TELEMETRY=1 \
    DISABLE_ERROR_REPORTING=1
RUN --mount=type=bind,source=docker/calliope,target=/run/calliope-build,readonly \
    cp /run/calliope-build/test-hermes-claude-subscription-plugin.py /tmp/test-hermes-claude-subscription-plugin.py \
    && cd /opt/hermes && python /tmp/test-hermes-claude-subscription-plugin.py \
    && rm /tmp/test-hermes-claude-subscription-plugin.py

# Match the CLI used by the pilot, but do not depend on uvx downloading it into
# a customer's data volume at first use. Install apart from Hermes' dependencies.
RUN UV_TOOL_DIR=/opt/calliope/browser-tools UV_TOOL_BIN_DIR=/usr/local/bin \
      uv tool install --python /opt/hermes/.venv/bin/python browser-use==0.13.10 \
    && chmod -R a+rX /opt/calliope/browser-tools

