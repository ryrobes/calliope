    && git apply --recount /tmp/hermes-run-context.patch \
    && rm /tmp/hermes-run-context.patch \
    && git apply --check --include=agent/prompt_builder.py /tmp/hermes-skill-index.patch \
    && git apply --include=agent/prompt_builder.py /tmp/hermes-skill-index.patch \
    && git apply --check --include=gateway/platforms/api_server.py /tmp/hermes-progressive-sql-results.patch \
    && git apply --include=gateway/platforms/api_server.py /tmp/hermes-progressive-sql-results.patch \
