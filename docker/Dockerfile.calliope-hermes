    && git apply --check --include=agent/model_metadata.py /tmp/hermes-deepinfra-output-cap.patch \
    && git apply --include=agent/model_metadata.py /tmp/hermes-deepinfra-output-cap.patch \
    && git apply --check --include=agent/agent_init.py /tmp/hermes-explicit-small-context.patch \
    && git apply --include=agent/agent_init.py /tmp/hermes-explicit-small-context.patch \
    && git apply --check --recount /tmp/hermes-profile-log-routing.patch \
    && git apply --recount /tmp/hermes-profile-log-routing.patch \
    && git apply --check --recount --include=gateway/platforms/api_server.py /tmp/hermes-command-catalog.patch \
    && git apply --recount --include=gateway/platforms/api_server.py /tmp/hermes-command-catalog.patch \
    && git apply --check --recount --include=gateway/platforms/api_server.py /tmp/hermes-auxiliary-tts-rewrite.patch \
    && git apply --recount --include=gateway/platforms/api_server.py /tmp/hermes-auxiliary-tts-rewrite.patch \
    && git apply --check --recount --include=agent/transports/chat_completions.py /tmp/hermes-tool-result-wire-name.patch \
    && git apply --recount --include=agent/transports/chat_completions.py /tmp/hermes-tool-result-wire-name.patch \
    && git apply --check --recount --include=tools/tool_search.py /tmp/hermes-deferred-tool-argument-unwrap.patch \
    && git apply --recount --include=tools/tool_search.py /tmp/hermes-deferred-tool-argument-unwrap.patch \
    && git apply --check --recount /tmp/hermes-shared-oauth-root-store.patch \
    && git apply --recount /tmp/hermes-shared-oauth-root-store.patch \
