ARG HERMES_BASE_IMAGE=nousresearch/hermes-agent@sha256:6bece0644e29a347e5ae17db43c36938c86f171c6f5e0cef18aa2075d331f3a3
FROM ${HERMES_BASE_IMAGE}

USER root

# Browser Use needs full Chromium, not chrome-headless-shell. Keep it in the
# image: a fresh/migrated /opt/data volume must not disable browser automation.
RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium file jq \
    && chromium --version \
    && rm -rf /var/lib/apt/lists/*
RUN uv pip install --python /opt/hermes/.venv/bin/python Pillow==12.0.0
# Catalog-only backport; keep the pinned Hermes transport/auth implementation.
# Provenance and scope: docker/calliope/hermes-subscription-model-catalog.md.
RUN --mount=type=bind,source=docker/calliope,target=/run/calliope-build,readonly \
    cp /run/calliope-build/hermes-subscription-model-catalog.patch /run/calliope-build/test-hermes-subscription-model-catalog.py /tmp/ \
    && cd /opt/hermes \
    && git apply --check /tmp/hermes-subscription-model-catalog.patch \
    && git apply /tmp/hermes-subscription-model-catalog.patch \
    && python /tmp/test-hermes-subscription-model-catalog.py \
    && rm /tmp/hermes-subscription-model-catalog.patch /tmp/test-hermes-subscription-model-catalog.py
RUN --mount=type=bind,source=docker/calliope,target=/run/calliope-build,readonly \
    cp /run/calliope-build/apply-hermes-nested-tool-ledger.py /tmp/apply-hermes-nested-tool-ledger.py \
    && python /tmp/apply-hermes-nested-tool-ledger.py && rm /tmp/apply-hermes-nested-tool-ledger.py
COPY docker/calliope/hermes-managed-images.py /opt/hermes/gateway/calliope_managed_images.py
RUN --mount=type=bind,source=docker/calliope,target=/run/calliope-build,readonly \
    cp /run/calliope-build/apply-hermes-managed-images.py /tmp/apply-hermes-managed-images.py \
    && python /tmp/apply-hermes-managed-images.py && rm /tmp/apply-hermes-managed-images.py
COPY services/calliope/media_ledger.py /opt/hermes/gateway/calliope_media_ledger.py
COPY services/calliope/specialist_assignment.py /opt/hermes/gateway/calliope_specialist_assignment.py
COPY services/calliope/tool_arguments.py \
    services/calliope/stage_delivery.py \
    /opt/hermes/
ENV CALLIOPE_CHROMIUM_PATH=/usr/bin/chromium

# A compact, pinned web-artifact toolchain. `calliope-web-check` gives Hermes
# one quiet command for HTML structure plus embedded/browser JavaScript parsing
# and linting; it avoids dumping a completed dashboard back into model context.
RUN npm install --global --no-audit --no-fund \
        prettier@3.9.6 \
        eslint@10.8.1 \
        html-validate@11.6.2 \
    && prettier --version \
    && eslint --version \
    && html-validate --version \
    && npm cache clean --force
COPY docker/calliope/interaction-check/ /opt/hermes/calliope/interaction-check/
COPY --chmod=0755 docker/calliope/bin/calliope-interaction-check /usr/local/bin/calliope-interaction-check
RUN node --test /opt/hermes/calliope/interaction-check/test.cjs
COPY docker/calliope/web-check/ /opt/hermes/calliope/web-check/
COPY --chmod=0755 docker/calliope/bin/calliope-web-check /usr/local/bin/calliope-web-check

