    && PYTHONPATH=/opt/hermes /opt/hermes/.venv/bin/python /tmp/test-hermes-nested-tool-ledger.py \
    && PYTHONPATH=/opt/hermes /opt/hermes/.venv/bin/python /tmp/test-hermes-managed-images.py \
    && rm /tmp/test-hermes-nested-tool-ledger.py /tmp/test-hermes-managed-images.py

# Recover original session evidence after compaction; index new records asynchronously.
COPY docker/calliope/hermes-session-context.py /opt/hermes/tools/calliope_session_context.py
COPY docker/calliope/hermes-compaction-scope.py /opt/hermes/tools/calliope_compaction_scope.py
COPY docker/calliope/hermes-middle-memory.py /opt/hermes/tools/calliope_middle_memory.py
COPY docker/calliope/hermes-tool-deadlines.py /opt/hermes/agent/calliope_tool_deadlines.py
RUN --mount=type=bind,source=docker/calliope,target=/run/calliope-build,readonly \
    cp /run/calliope-build/apply-hermes-context-recall.py /run/calliope-build/test-hermes-context-recall.py /tmp/ \
    && python /tmp/apply-hermes-context-recall.py \
    && cd /opt/hermes && python /tmp/test-hermes-context-recall.py \
    && rm /tmp/apply-hermes-context-recall.py /tmp/test-hermes-context-recall.py

# Deliver each completed Stage output independently of a parallel tool batch.
COPY docker/calliope/hermes-stage-events.py /opt/hermes/gateway/calliope_stage_events.py
COPY services/calliope/artifact_progress.py /opt/hermes/artifact_progress.py
COPY docker/calliope/hermes-artifact-progress.py /opt/hermes/gateway/calliope_artifact_progress.py
RUN --mount=type=bind,source=docker/calliope,target=/run/calliope-build,readonly \
    cp /run/calliope-build/apply-hermes-stage-events.py /run/calliope-build/test-hermes-stage-events.py /tmp/ \
    && python /tmp/apply-hermes-stage-events.py \
    && cd /opt/hermes && python /tmp/test-hermes-stage-events.py \
    && rm /tmp/apply-hermes-stage-events.py /tmp/test-hermes-stage-events.py

RUN --mount=type=bind,source=docker/calliope,target=/run/calliope-build,readonly \
    cp /run/calliope-build/apply-hermes-artifact-progress.py /run/calliope-build/test-hermes-stage-events.py /run/calliope-build/test-hermes-artifact-progress.py /tmp/ \
    && python /tmp/apply-hermes-artifact-progress.py \
    && python -m compileall -q /opt/hermes/artifact_progress.py /opt/hermes/gateway/calliope_artifact_progress.py \
    && cd /opt/hermes && python /tmp/test-hermes-artifact-progress.py \
    && rm /tmp/apply-hermes-artifact-progress.py /tmp/test-hermes-stage-events.py /tmp/test-hermes-artifact-progress.py

# Stop a delegation/question/SQL call whose streamed arguments never end, and end
# the turn on it instead of retrying (CALLIOPE_BRIEF_TOOL_ARGS_MAX_CHARS).
COPY docker/calliope/hermes-runaway-tool-arguments.py /opt/hermes/gateway/calliope_runaway_tool_arguments.py
RUN --mount=type=bind,source=docker/calliope,target=/run/calliope-build,readonly \
    cp /run/calliope-build/apply-hermes-runaway-tool-arguments.py /run/calliope-build/test-hermes-runaway-tool-arguments.py /tmp/ \
    && python /tmp/apply-hermes-runaway-tool-arguments.py \
    && python -m compileall -q /opt/hermes/gateway/calliope_runaway_tool_arguments.py \
    && cd /opt/hermes && python /tmp/test-hermes-runaway-tool-arguments.py \
    && rm /tmp/apply-hermes-runaway-tool-arguments.py /tmp/test-hermes-runaway-tool-arguments.py
# Hindsight reads and writes what the person said, not Calliope's per-turn context,
# and recall only returns memories everyone in the conversation could see.
COPY docker/calliope/hermes-memory-scope.py /opt/hermes/gateway/calliope_memory_scope.py
RUN --mount=type=bind,source=docker/calliope,target=/run/calliope-build,readonly \
    cp /run/calliope-build/apply-hermes-memory-scope.py /run/calliope-build/test-hermes-memory-scope.py /tmp/ \
    && python /tmp/apply-hermes-memory-scope.py \
    && python -m compileall -q /opt/hermes/gateway/calliope_memory_scope.py \
       /opt/hermes/gateway/platforms/api_server_runs.py /opt/hermes/agent/memory_manager.py \
       /opt/hermes/plugins/memory/hindsight/__init__.py \
    && cd /opt/hermes && python /tmp/test-hermes-memory-scope.py \
    && rm /tmp/apply-hermes-memory-scope.py /tmp/test-hermes-memory-scope.py

# Imports in build-time tests can create runtime files as root in HERMES_HOME.
# Docker copies those into an empty named volume; root-owned logs then abort
# upstream's first-boot setup before it seeds config.yaml. Ship an empty home
# so only the normal cont-init hooks initialize a customer's durable state.
RUN find /opt/data -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + \
    && chown hermes:hermes /opt/data \
    && chmod 0700 /opt/data

LABEL org.opencontainers.image.title="Calliope Hermes" \
      org.opencontainers.image.description="Pinned Hermes Agent with Calliope defaults and first-party MCP provenance forwarding" \
      org.opencontainers.image.base.name="nousresearch/hermes-agent@sha256:6bece0644e29a347e5ae17db43c36938c86f171c6f5e0cef18aa2075d331f3a3" \
      org.opencontainers.image.base.revision="d337b736aa1e8ebecfab043842d13e4a2d2f48a3"

RUN --mount=type=bind,source=docker/calliope,target=/run/calliope-build,readonly \
