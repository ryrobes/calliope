COPY docker/calliope/hermes-capability-discovery.py /opt/hermes/tools/calliope_capability_discovery.py
RUN --mount=type=bind,source=docker/calliope,target=/run/calliope-build,readonly \
    cp /run/calliope-build/hermes-capability-discovery.patch /run/calliope-build/test-hermes-capability-discovery.py /tmp/ \
