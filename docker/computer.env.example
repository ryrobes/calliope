# Dedicated Computer VM. Initialize the remaining Computer credentials with:
# python3 scripts/release/provision-computer-use-env.py --env-file /opt/calliope-computer/.env
# For a migration, retain the appliance's existing Computer credentials instead.
# Keep this file mode 0600; pass only this limited file to the VM.
CALLIOPE_VERSION=1.1.4
CALLIOPE_REGISTRY=ghcr.io/ryrobes
CALLIOPE_COMPUTER_BIND_ADDRESS=
CALLIOPE_COMPUTER_DECISION_URL=
CALLIOPE_DESKTOP_RESOLUTION=1280x720
CALLIOPE_DESKTOP_MAX_FRAME_RATE=24
# Explicit Mesa software rendering for VMs; use auto for a GPU-backed desktop.
CALLIOPE_BROWSER_RENDERER=software
