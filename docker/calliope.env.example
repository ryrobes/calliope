# Runtime contract for docker/docker-compose.calliope.yml.
# The provisioner writes the real file to /opt/rvbbit/.env with mode 0600.
# Never commit a populated copy.

# Service key for your Clover gateway. Postgres, Hermes, the isolated Hindsight
# service and Warehouse's spoken-response rewrite all call the gateway with it.
RVBBIT_CLOVER_KEY=
RVBBIT_CLOVER_OPENAI_BASE_URL=http://clover:8090/v1
RVBBIT_CLOVER_REQUIRED_MODEL=calliope

# Product image settings consumed by docker-compose.calliope.yml. Choose a
# published release tag or one built/transferred locally; verify every selected
# component exists. Generic RVBBIT_*_IMAGE variables do not select these images.
CALLIOPE_REGISTRY=ghcr.io/ryrobes
CALLIOPE_VERSION=
CALLIOPE_REVISION=
CALLIOPE_ORIGIN_IMAGE=caddy:2.10.2-alpine

# Generated independently by the provisioner. Use long random values and do
# not reuse the Clover key, a database password, or one another.
POSTGRES_PASSWORD=
RVBBIT_CREDENTIAL_KEY=
RVBBIT_GATEWAY_TOKEN=
RVBBIT_MIRROR_TOKEN=
WAREHOUSE_JWT_SECRET=
WAREHOUSE_MCP_KEY=
WAREHOUSE_HERMES_API_KEY=
WAREHOUSE_HERMES_MCP_KEY=

# Initial exact one-email administrator boundary. Google sign-in can replace
# this later without blocking first boot.
WAREHOUSE_LOGIN_PASSWORD=
WAREHOUSE_ALLOWED_EMAILS=admin@example.com
WAREHOUSE_TEAM_BOOTSTRAP_ADMINS=admin@example.com
WAREHOUSE_HERMES_MEMORY_KEY=company
# Long-form model calls (topology, design synthesis, Dream). Short health and
# control probes retain their own small deadlines.
WAREHOUSE_HERMES_INFERENCE_TIMEOUT_SECONDS=900
WAREHOUSE_CALLIOPE_DREAM_HERMES_TIMEOUT_SECONDS=900
# Set false to hide the tiny turn/session token diagnostic in Calliope's header.
WAREHOUSE_CALLIOPE_DEBUG_TOKEN_METER=true
# Managed Hermes working budget for the Hutch `calliope` route (compaction
# fires at 70% of it). A Calliope turn is ~86k prompt tokens before any
# conversation, so keep this well above 131072; lower it only for a route
# whose real window is smaller.
CALLIOPE_MODEL_CONTEXT_LENGTH=262144
CALLIOPE_MODEL_MAX_TOKENS=32768

# Optional spoken Calliope responses. Both values are required to enable the
# server-side ElevenLabs stream; semantic script rewriting uses the model
# selected under Models & agents -> Background tasks.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Total bounded window for the spoken rewrite, delivery tags, and first audio.
# The writer reserves separate budgets for tagging and audio.
WAREHOUSE_CALLIOPE_TTS_PREPARE_TIMEOUT_SECONDS=120
# Expressive mode: separate Clover/Hutch call for tags only. Switch to calliope-sol
# to test delivery independently of the Background Tasks spoken-text writer.
WAREHOUSE_CALLIOPE_TTS_TAG_MODEL=calliope-luna

# Browser routing. WAREHOUSE_PUBLIC_URL must be set even for a tunnelled
# appliance: a blank value selects API-key-only mode and disables browser login.
# For an SSH forward on local port 18080, use http://localhost:18080 for both
# WAREHOUSE_PUBLIC_URL and LENS_PUBLIC_URL. CALLIOPE_PUBLIC_HOST can stay blank
# for tunnels or externally terminated TLS (plain http on RVBBIT_ORIGIN_PORT).
#
# For a public HTTPS appliance: point a DNS A record at the host, allow
# tcp/80 and tcp/443 from the internet, then set
#   CALLIOPE_PUBLIC_HOST=calliope.example.com
#   CALLIOPE_ACME_EMAIL=ops@example.com          # optional, cert expiry notices
#   WAREHOUSE_PUBLIC_URL=https://calliope.example.com
#   LENS_PUBLIC_URL=https://calliope.example.com
#   RVBBIT_ORIGIN_PORT=80
#   RVBBIT_ORIGIN_TLS_PORT=443
# Caddy then obtains and renews the certificate itself (ACME needs :80 and
# :443 reachable) and redirects http to https. WAREHOUSE_PUBLIC_URL is also
# the MCP OAuth issuer, so it must match the served origin exactly.
CALLIOPE_PUBLIC_HOST=
# Optional phone-share address when the browser UI uses a localhost tunnel.
# This is navigation only; Google still uses WAREHOUSE_PUBLIC_URL for callbacks.
WAREHOUSE_NATIVE_PUBLIC_URL=
CALLIOPE_ACME_EMAIL=
WAREHOUSE_PUBLIC_URL=
LENS_PUBLIC_URL=
RVBBIT_ORIGIN_PORT=8080
RVBBIT_ORIGIN_TLS_PORT=127.0.0.1:8443
# Maps for hosted dashboards. A Mapbox *public* token created for this
# appliance and URL-restricted to its hostname (Mapbox account → Tokens →
# "URL restrictions"). Served into hosted dashboard pages and captures at
# render time; never written into an artifact. Leave empty to disable maps.
WAREHOUSE_MAPBOX_TOKEN=
# Advanced DataRabbit/Burrow diagnostic entrypoint. Keep loopback-only and use
# an SSH tunnel unless the deployment's TLS proxy deliberately exposes it.
RVBBIT_BURROW_PORT=127.0.0.1:3001
# The raw Lens listener is not a complete auth origin; keep it local as well.
RVBBIT_LENS_PORT=127.0.0.1:3000
# Only external-Hermes/uber deployments need WAREHOUSE_CALLIOPE_EXPORT_DIR.
# The hosted stack shares its durable Hermes /opt/data volume with Warehouse
# read-only, avoiding a second host directory and its UID/permission hazards.
WAREHOUSE_CALLIOPE_EXPORT_DIR=/opt/rvbbit/calliope-exports
# Container-local allowlist for explicit server-folder Company Brain imports.
# `brain_crawl_folder` rejects `/` and anything outside these roots.
WAREHOUSE_BRAIN_IMPORT_ROOTS=/opt/data/workspace:/opt/data/outputs:/app/data/brain-imports
WAREHOUSE_FILE_IMPORT_ROOTS=/opt/data/workspace:/opt/data/outputs:/app/data/brain-imports

# Hosted invariants.
RVBBIT_REQUIRE_CANONICAL_CREDENTIALS=true
RVBBIT_MODE=burrow
WAREHOUSE_AUTH=shared
WAREHOUSE_LOGIN_UI=lens
WAREHOUSE_CALLIOPE_STT_PROVIDER=off
# Optional authenticated demo handset at /calliope/sms-simulator (no carrier sends).
WAREHOUSE_CALLIOPE_SMS_SIMULATOR_ENABLED=0
