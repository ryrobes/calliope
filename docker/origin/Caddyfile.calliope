# Hosted Calliope has two doors on one Caddy process. The customer door lands
# in the Gallery; the advanced Burrow door lands in DataRabbit. Both proxy the
# same Warehouse authentication and application routes, so the host-scoped
# wh_session cookie works across ports without putting Next.js under a path.
#
# Env: ORIGIN_LISTEN (default :80), BURROW_LISTEN (default :81),
# LENS_UPSTREAM (default datarabbit:3000), WAREHOUSE_UPSTREAM (default
# calliope:8765), and CALLIOPE_ACME_EMAIL (optional certificate contact).
#
# TLS: the customer door's site address is ORIGIN_LISTEN. When Compose sets it
# to the appliance's public hostname (CALLIOPE_PUBLIC_HOST), Caddy becomes the
# TLS terminator — it obtains and renews a publicly trusted certificate through
# ACME, serves https on :443, and answers http on :80 with the ACME challenge
# plus a redirect to https. Both container ports must then be published on the
# host and reachable from the internet. Leaving ORIGIN_LISTEN at :80 keeps the
# plain listener for deployments that terminate TLS elsewhere or are reached
# over an SSH tunnel. Fresh installs serve DataRabbit over HTTPS on the same
# hostname at :3001, sharing the certificate and host-scoped login cookie.
# The :81 fallback remains for older loopback-only configurations.
#
# Behind an operator's own HTTPS proxy (installer CALLIOPE_TLS=proxy), both
# doors keep their plain listeners and CALLIOPE_TRUSTED_PROXIES names the
# proxy, so its X-Forwarded-Proto/Host survive. Other clients cannot set them.

{
	# Blank is allowed: Let's Encrypt does not require a contact address, and
	# the option is inert until ORIGIN_LISTEN names a public host.
	email "{$CALLIOPE_ACME_EMAIL:}"
	# Loopback by default: nothing outside this container is trusted.
	servers {
		trusted_proxies static {$CALLIOPE_TRUSTED_PROXIES:127.0.0.1/32}
	}
}

{$ORIGIN_LISTEN::80} {
	# Stable entry point also brings Google sign-in back to the DataRabbit door.
	handle /datarabbit {
		redir {$DATARABBIT_PUBLIC_URL:http://localhost:3001} 302
	}

	@root path /
	handle @root {
		# The Floor is the front door of the appliance: a fresh login or a
		# bare-domain visit lands on the shared work graph, not a subpage.
		redir * /floor 302
	}

	# Lens owns the branded login page. Its compiled Next assets stay available
	# here, but the DataRabbit application itself does not own this root.
	@login_get {
		method GET
		path /login
	}
	handle @login_get {
		reverse_proxy {$LENS_UPSTREAM:datarabbit:3000}
	}
	@lens_login_assets {
		path /_next/* /pre-hydration.js /icon /favicon.ico
	}
	handle @lens_login_assets {
		reverse_proxy {$LENS_UPSTREAM:datarabbit:3000}
	}

	# The application gateway owns the shared desktop stream and revokes open
	# control sockets on handoff. Never proxy VNC around that gateway.
	handle /computer* {
		redir * /calliope 302
	}

	@warehouse {
		path /mcp /mcp/* /login /auth/* /connect /connect/* /account /account/* /meaning/meaning.css /authorize /authorize/* /token /register \
 /.well-known/* /apps /apps/* /d/* /api/d/* /api/apps/* /thumbs/* /pdfs/* /bg/* /theme/* /charts/* /vendor/* /health /webhooks/twilio \
 /gallery /api/gallery/* /calliope /calliope/* /api/calliope/* /desk /desk/* /floor /floor/* /team /team/* /ops /ops/* /data /data/*
	}
	handle @warehouse {
		# /mcp is streamable HTTP; response buffering breaks tool traffic.
		reverse_proxy {$WAREHOUSE_UPSTREAM:calliope:8765} {
			flush_interval -1
		}
	}

	# Unknown customer-facing paths belong to the Warehouse, which returns its
	# own authenticated 404 rather than accidentally exposing DataRabbit.
	handle {
		reverse_proxy {$WAREHOUSE_UPSTREAM:calliope:8765} {
			flush_interval -1
		}
	}
}

{$BURROW_LISTEN::81} {
	# Burrow keeps the original unified-origin contract: DataRabbit owns the
	# root while Warehouse owns sessions, artifacts, Calliope, and MCP routes.
	@login_get {
		method GET
		path /login
	}
	handle @login_get {
		redir {$WAREHOUSE_PUBLIC_URL:http://localhost:8080}/login?next=/datarabbit 302
	}
	handle /datarabbit {
		redir / 302
	}

	# The application gateway owns the shared desktop stream and revokes open
	# control sockets on handoff. Never proxy VNC around that gateway.
	handle /computer* {
		redir * /calliope 302
	}

	@warehouse {
		path /mcp /mcp/* /login /auth/* /connect /connect/* /account /account/* /meaning/meaning.css /authorize /authorize/* /token /register \
 /.well-known/* /apps /apps/* /d/* /api/d/* /api/apps/* /thumbs/* /pdfs/* /bg/* /theme/* /charts/* /vendor/* /health /webhooks/twilio \
 /gallery /api/gallery/* /calliope /calliope/* /api/calliope/* /desk /desk/* /floor /floor/* /team /team/* /ops /ops/* /data /data/*
	}
	handle @warehouse {
		reverse_proxy {$WAREHOUSE_UPSTREAM:calliope:8765} {
			flush_interval -1
		}
	}

	handle {
		# DataRabbit contains instance administration APIs, not just its page
		# shell. Reuse Calliope's account-administrator check for EVERY request.
		# Its successful response body is discarded; no account settings are
		# forwarded to the browser or DataRabbit. Denials and outages fail closed.
		route {
			@cross_origin {
				not method GET HEAD OPTIONS
				not header Origin {$DATARABBIT_PUBLIC_URL:http://localhost:3001}
			}
			respond @cross_origin "Use the DataRabbit interface to make changes." 403
			forward_auth {$WAREHOUSE_UPSTREAM:calliope:8765} {
				uri /api/calliope/account/settings
				@login_required status 401
				handle_response @login_required {
					@api path /api/*
					handle @api {
						respond "Sign in to Calliope to use DataRabbit." 401
					}
					handle {
						redir {$WAREHOUSE_PUBLIC_URL:http://localhost:8080}/login?next=/datarabbit 302
					}
				}
			}
			reverse_proxy {$LENS_UPSTREAM:datarabbit:3000}
		}
	}
}
