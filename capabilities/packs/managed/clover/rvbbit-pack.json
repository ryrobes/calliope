{
  "api_version": "rvbbit.pack/v1",
  "id": "managed/clover",
  "name": "clover",
  "title": "Clover",
  "description": "Clover's semantic SQL operators, served by the Clover gateway (Hutch) in your own install, on your OpenRouter key: 80 operators — typed field extraction with confidences and spans, contract-validated JSON, Jev decisions, classifiers and decision trees, embeddings and rerank, sentiment, NLI and moderation judgments, language detection and transcription, safe web extraction, 22 LLM operators for fuzzy judgment and synthesis, and cited web research. Entity extraction, time-series analysis, clustering and anomaly detection run on optional local workers; document parsing, forecasting, image embeddings, tabular AutoML and relation extraction need a compatible worker.",
  "tags": [
    "managed",
    "clover",
    "bundle",
    "specialists",
    "llm",
    "web",
    "documents",
    "self-hosted"
  ],
